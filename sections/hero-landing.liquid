{% assign product = all_products['zendesk-pro'] %}

<section class="hero-section">
  <div class="hero-container container">
    
    <!-- PRODUCT GALLERY - Premium Carousel (8 Images) -->
    <div class="hero-gallery">
      <div class="carousel-main">
        <div class="carousel-track" id="carousel-track">
          {% for i in (1..8) %}
            <div class="carousel-slide {% if forloop.first %}active{% endif %}">
              <img 
                src="{{ 'zen-pro-gallery-' | append: i | append: '.png' | asset_url }}" 
                alt="ZenDesk Pro - Vista {{ i }}" 
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              >
            </div>
          {% endfor %}
        </div>
        
        <!-- Navigation Arrows -->
        <button class="carousel-arrow carousel-prev" aria-label="Imagen anterior">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>
        <button class="carousel-arrow carousel-next" aria-label="Imagen siguiente">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>

      <!-- Thumbnail Navigation -->
      <div class="carousel-thumbnails">
        {% for i in (1..8) %}
          <button 
            class="thumbnail {% if forloop.first %}active{% endif %}" 
            data-index="{{ forloop.index0 }}"
            aria-label="Ir a imagen {{ i }}"
          >
            <img 
              src="{{ 'zen-pro-gallery-' | append: i | append: '.png' | asset_url }}" 
              alt="Miniatura {{ i }}"
              loading="lazy"
            >
          </button>
        {% endfor %}
      </div>
    </div>

    <!-- HERO CONTENT -->
    <div class="hero-content">
      <div class="hero-badge">
        🔥 ¡40% DE DESCUENTO SOLO HOY!
      </div>
      
      <h1 class="hero-title">
        Trabaja con comodidad desde tu cama con <span class="text-accent">ZenDesk Pro</span>
      </h1>
      
      <h2 class="hero-subtitle">
        El escritorio multifuncional que transforma tu descanso en productividad extrema.
      </h2>
      
      <ul class="hero-features">
        <li>✓ Diseño ergonómico ajustable</li>
        <li>✓ Materiales premium de alta calidad</li>
        <li>✓ Estilo minimalista IKEA × Apple</li>
      </ul>

      <!-- SHOPIFY PRODUCT FORM -->
      {% form 'product', product %}
        <div class="variant-selector">
          <p class="variant-label">Elige tu color favorito:</p>
          <div class="variant-swatches">
            {% for variant in product.variants %}
              <label class="swatch-wrapper">
                <input 
                  type="radio" 
                  name="id" 
                  value="{{ variant.id }}" 
                  class="variant-radio"
                  {% if forloop.first %}checked{% endif %}
                >
                <span class="swatch-visual" data-color="{{ variant.option1 | handle }}">
                  <span class="swatch-checkmark">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M13.3334 4L6.00002 11.3333L2.66669 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </span>
                <span class="swatch-label">{{ variant.option1 }}</span>
              </label>
            {% endfor %}
          </div>
        </div>

        <button type="submit" name="add" class="hero-cta">
          ¡Quiero mi ZenDesk Pro ahora!
        </button>
      {% endform %}
      
      <div class="hero-trust-badges">
        <span>🚚 Envío rápido garantizado</span>
        <span>🔒 Compra 100% segura</span>
      </div>
    </div>

  </div>
</section>

<style>
  /* ============================================
     HERO SECTION - PREMIUM DESIGN
     ============================================ */
  
  .hero-section {
    background: linear-gradient(135deg, var(--color-bg-primary) 0%, var(--color-bg-secondary) 100%);
    padding: var(--space-2xl) 0;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  /* ============================================
     GALLERY CAROUSEL - SMOOTH & INTERACTIVE
     ============================================ */
  
  .hero-gallery {
    position: relative;
  }

  .carousel-main {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #FFFFFF;
    box-shadow: var(--shadow-strong);
    aspect-ratio: 1 / 1;
  }

  .carousel-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .carousel-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--transition-smooth);
    pointer-events: none;
  }

  .carousel-slide.active {
    opacity: 1;
    pointer-events: auto;
  }

  .carousel-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Carousel Arrows */
  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    background: rgba(255, 255, 255, 0.95);
    border: none;
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-soft);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-primary);
    transition: all var(--transition-fast);
    z-index: 10;
  }

  .carousel-arrow:hover {
    background: #FFFFFF;
    box-shadow: var(--shadow-medium);
    transform: translateY(-50%) scale(1.05);
  }

  .carousel-prev {
    left: var(--space-sm);
  }

  .carousel-next {
    right: var(--space-sm);
  }

  /* Thumbnail Navigation */
  .carousel-thumbnails {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .thumbnail {
    aspect-ratio: 1 / 1;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    background: #FFFFFF;
    padding: 0;
    transition: all var(--transition-fast);
  }

  .thumbnail:hover {
    border-color: var(--color-accent-warm);
    transform: scale(1.05);
  }

  .thumbnail.active {
    border-color: var(--color-text-primary);
    box-shadow: var(--shadow-soft);
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ============================================
     HERO CONTENT - TYPOGRAPHY & CTA
     ============================================ */
  
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .hero-badge {
    display: inline-flex;
    align-self: flex-start;
    background: linear-gradient(135deg, #FF6B35 0%, #FF8E53 100%);
    color: #FFFFFF;
    font-size: 0.875rem;
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-soft);
    animation: pulse-glow 2s ease-in-out infinite;
  }

  @keyframes pulse-glow {
    0%, 100% { box-shadow: var(--shadow-soft); }
    50% { box-shadow: 0 0 20px rgba(255, 107, 53, 0.4); }
  }

  .hero-title {
    font-size: clamp(1.75rem, 5vw, 3rem);
    line-height: 1.1;
    margin: 0;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.375rem);
    font-weight: var(--font-weight-normal);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .hero-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  .hero-features li {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  /* ============================================
     VARIANT SELECTOR - PREMIUM SWATCHES
     ============================================ */
  
  .variant-selector {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md) 0;
  }

  .variant-label {
    font-weight: var(--font-weight-semibold);
    font-size: 1rem;
    margin: 0;
  }

  .variant-swatches {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .swatch-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    cursor: pointer;
  }

  .variant-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .swatch-visual {
    position: relative;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-full);
    border: 3px solid #E5E7EB;
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Color Mapping */
  .swatch-visual[data-color="white"] {
    background: #FFFFFF;
    box-shadow: inset 0 0 0 1px #E5E7EB;
  }

  .swatch-visual[data-color="black"] {
    background: #1A1A1A;
  }

  .swatch-visual[data-color="pink"] {
    background: #FFB6C1;
  }

  .swatch-visual[data-color="walnut"] {
    background: #8B4513;
  }

  .swatch-checkmark {
    opacity: 0;
    color: #FFFFFF;
    transition: opacity var(--transition-fast);
  }

  .swatch-visual[data-color="white"] .swatch-checkmark {
    color: var(--color-text-primary);
  }

  .variant-radio:checked + .swatch-visual {
    border-color: var(--color-text-primary);
    transform: scale(1.08);
    box-shadow: var(--shadow-soft);
  }

  .variant-radio:checked + .swatch-visual .swatch-checkmark {
    opacity: 1;
  }

  .swatch-wrapper:hover .swatch-visual {
    transform: scale(1.05);
    border-color: var(--color-accent-warm);
  }

  .swatch-label {
    font-size: 0.875rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    text-align: center;
  }

  /* ============================================
     HERO CTA BUTTON
     ============================================ */
  
  .hero-cta {
    width: 100%;
    margin-top: var(--space-sm);
  }

  /* ============================================
     TRUST BADGES
     ============================================ */
  
  .hero-trust-badges {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-top: var(--space-xs);
  }

  .hero-trust-badges span {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* ============================================
     MOBILE RESPONSIVE (375px - 768px)
     ============================================ */
  
  @media (max-width: 768px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .hero-gallery {
      order: 1;
    }

    .hero-content {
      order: 2;
      text-align: center;
      align-items: center;
    }

    .hero-badge {
      align-self: center;
    }

    .hero-features {
      align-items: flex-start;
      text-align: left;
    }

    .variant-swatches {
      justify-content: center;
    }

    .carousel-thumbnails {
      grid-template-columns: repeat(4, 1fr);
    }

    .carousel-arrow {
      width: 40px;
      height: 40px;
    }

    .hero-trust-badges {
      justify-content: center;
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .carousel-thumbnails {
      gap: 4px;
    }

    .thumbnail {
      border-width: 1.5px;
    }
  }
</style>

<script>
  // ============================================
  // HERO CAROUSEL - VANILLA JS (NO DEPENDENCIES)
  // ============================================
  (function() {
    const track = document.getElementById('carousel-track');
    if (!track) return;

    const slides = Array.from(track.querySelectorAll('.carousel-slide'));
    const thumbnails = Array.from(document.querySelectorAll('.thumbnail'));
    const prevBtn = document.querySelector('.carousel-prev');
    const nextBtn = document.querySelector('.carousel-next');
    
    let currentIndex = 0;

    function goToSlide(index) {
      // Remove active class from all
      slides.forEach(slide => slide.classList.remove('active'));
      thumbnails.forEach(thumb => thumb.classList.remove('active'));
      
      // Add active to current
      slides[index].classList.add('active');
      thumbnails[index].classList.add('active');
      currentIndex = index;
    }

    function nextSlide() {
      const newIndex = (currentIndex + 1) % slides.length;
      goToSlide(newIndex);
    }

    function prevSlide() {
      const newIndex = (currentIndex - 1 + slides.length) % slides.length;
      goToSlide(newIndex);
    }

    // Event Listeners
    if (nextBtn) nextBtn.addEventListener('click', nextSlide);
    if (prevBtn) prevBtn.addEventListener('click', prevSlide);

    thumbnails.forEach((thumb, index) => {
      thumb.addEventListener('click', () => goToSlide(index));
    });

    // Auto-play (optional, every 5 seconds)
    // setInterval(nextSlide, 5000);
  })();
</script>

{% schema %}
{
  "name": "hero-landing"
}
{% endschema %}
