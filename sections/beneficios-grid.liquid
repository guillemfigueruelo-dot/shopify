<section class="beneficios-section">
  <div class="container">
    <header class="beneficios-header">
      <h2 class="beneficios-title">Designed for excellence</h2>
      <p class="beneficios-subtitle">
        Every detail of the ZenDesk Pro has been carefully considered to offer you 
        the best work and rest experience.
      </p>
    </header>
    
    <div class="beneficios-grid">
      
      <!-- Beneficio 1: Superior Ergonomics -->
      <article class="benefit-card">
        <div class="benefit-icon">
          <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M28 8L8 18l20 10 20-10-20-10z"/>
            <path d="M8 38l20 10 20-10"/>
            <path d="M8 28l20 10 20-10"/>
          </svg>
        </div>
        <h3 class="benefit-title">Superior Ergonomics</h3>
        <p class="benefit-description">
          Adjustable angles designed to keep your spine in the ideal position 
          and eliminate cervical tension.
        </p>
      </article>

      <!-- Beneficio 2: Premium Material -->
      <article class="benefit-card">
        <div class="benefit-icon">
          <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="10" width="44" height="30" rx="4"/>
            <path d="M18 46h20"/>
            <path d="M28 40v6"/>
          </svg>
        </div>
        <h3 class="benefit-title">Premium Material</h3>
        <p class="benefit-description">
          High-quality wood with soft-touch finishes and proven resistance 
          for years of intensive use.
        </p>
      </article>

      <!-- Beneficio 3: Minimalist Style -->
      <article class="benefit-card">
        <div class="benefit-icon">
          <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="28" cy="20" r="10"/>
            <path d="M10 46c0-10 8-18 18-18s18 8 18 18"/>
          </svg>
        </div>
        <h3 class="benefit-title">Minimalist Style</h3>
        <p class="benefit-description">
          IKEA × Apple-inspired design that integrates perfectly into 
          any modern bedroom.
        </p>
      </article>

      <!-- Beneficio 4: Assembly in Seconds -->
      <article class="benefit-card">
        <div class="benefit-icon">
          <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 28h36"/>
            <path d="M28 10l18 18-18 18"/>
          </svg>
        </div>
        <h3 class="benefit-title">Assembly in Seconds</h3>
        <p class="benefit-description">
          No complicated tools or confusing instructions. 
          Unfold and adjust in less than 30 seconds.
        </p>
      </article>

      <!-- Beneficio 5: Total Portability -->
      <article class="benefit-card">
        <div class="benefit-icon">
          <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M28 10v24"/>
            <path d="M20 26l8 8 8-8"/>
            <rect x="14" y="34" width="28" height="8" rx="2"/>
          </svg>
        </div>
        <h3 class="benefit-title">Total Portability</h3>
        <p class="benefit-description">
          Foldable and ultra-light. Store it under the bed, in the closet 
          or take it with you on trips effortlessly.
        </p>
      </article>

      <!-- Beneficio 6: Ultra Stable -->
      <article class="benefit-card">
        <div class="benefit-icon">
          <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M28 6l-20 16v20c0 2 2 4 4 4h32c2 0 4-2 4-4V22L28 6z"/>
            <path d="M22 28l6 6 12-12"/>
          </svg>
        </div>
        <h3 class="benefit-title">Ultra Stable</h3>
        <p class="benefit-description">
          Wide base with intelligent weight distribution. 
          Zero wobbling even with 17-inch laptops.
        </p>
      </article>

    </div>
  </div>
</section>

<style>
  /* ============================================
     BENEFICIOS SECTION - PREMIUM GRID
     ============================================ */
  
  .beneficios-section {
    background: linear-gradient(180deg, var(--color-bg-primary) 0%, #FFFFFF 50%, var(--color-bg-primary) 100%);
    padding: var(--space-3xl) 0;
  }

  .beneficios-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--space-2xl);
  }

  .beneficios-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin-bottom: var(--space-md);
    color: var(--color-text-primary);
  }

  .beneficios-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* ============================================
     BENEFICIOS GRID - RESPONSIVE CARDS
     ============================================ */
  
  .beneficios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-lg);
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ============================================
     BENEFIT CARD - HOVER EFFECTS
     ============================================ */
  
  .benefit-card {
    background: #FFFFFF;
    padding: var(--space-xl);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    transition: all var(--transition-smooth);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    position: relative;
    overflow: hidden;
  }

  .benefit-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, var(--color-accent-warm) 0%, var(--color-cta-green) 100%);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-smooth);
  }

  .benefit-card:hover {
    transform: translateY(-12px);
    box-shadow: var(--shadow-strong);
  }

  .benefit-card:hover::before {
    transform: scaleX(1);
  }

  /* ============================================
     ICON STYLING
     ============================================ */
  
  .benefit-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
    border-radius: var(--radius-md);
    color: var(--color-accent-warm);
    transition: all var(--transition-base);
  }

  .benefit-card:hover .benefit-icon {
    transform: scale(1.1) rotate(5deg);
    background: linear-gradient(135deg, var(--color-accent-warm) 0%, #D4A853 100%);
    color: #FFFFFF;
    box-shadow: 0 8px 16px rgba(212, 168, 83, 0.3);
  }

  /* ============================================
     TEXT CONTENT
     ============================================ */
  
  .benefit-title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .benefit-description {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* ============================================
     MOBILE RESPONSIVE
     ============================================ */
  
  @media (max-width: 768px) {
    .beneficios-section {
      padding: var(--space-2xl) 0;
    }

    .beneficios-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .benefit-card {
      padding: var(--space-lg);
    }

    .benefit-icon {
      width: 56px;
      height: 56px;
    }

    .benefit-icon svg {
      width: 48px;
      height: 48px;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .beneficios-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "beneficios-grid"
}
{% endschema %}
