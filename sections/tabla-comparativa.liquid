<section class="tabla-comparativa" style="padding: 4rem 2rem; background-color: var(--color-background);">
  <h2 style="text-align: center; margin-bottom: 3rem; font-size: 2.5rem;">¿Por qué elegir ZenDesk Pro?</h2>

  <div style="max-width: 800px; margin: 0 auto; border-radius: var(--radius-card); overflow: hidden; box-shadow: var(--shadow-md);">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 1.1rem;">
      <thead>
        <tr style="background-color: #eee;">
          <th style="padding: 1.5rem; border-bottom: 2px solid #ddd;">Característica</th>
          <th style="padding: 1.5rem; border-bottom: 2px solid #ddd; background-color: var(--color-error-soft);">Sin ZenDesk Pro</th>
          <th style="padding: 1.5rem; border-bottom: 2px solid #ddd; background-color: var(--color-success-soft);">Con ZenDesk Pro</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="padding: 1.2rem; border-bottom: 1px solid #eee; font-weight: 500;">Comodidad</td>
          <td style="padding: 1.2rem; border-bottom: 1px solid #eee; color: #888;">❌ Mala/Inestable</td>
          <td style="padding: 1.2rem; border-bottom: 1px solid #eee; color: #2D8F4E; font-weight: bold;">✅ Total / Ergonómica</td>
        </tr>
        <tr>
          <td style="padding: 1.2rem; border-bottom: 1px solid #eee; font-weight: 500;">Salud (Espalda/Cuello)</td>
          <td style="padding: 1.2rem; border-bottom: 1px solid #eee; color: #888;">❌ Tensión constante</td>
          <td style="padding: 1.2rem; border-bottom: 1px solid #eee; color: #2D8F4E; font-weight: bold;">✅ Postura correcta</td>
        </tr>
        <tr>
          <td style="padding: 1.2rem; border-bottom: 1px solid #eee; font-weight: 500;">Productividad</td>
          <td style="padding: 1.2rem; border-bottom: 1px solid #eee; color: #888;">❌ Baja / Distracción</td>
          <td style="padding: 1.2rem; border-bottom: 1px solid #eee; color: #2D8F4E; font-weight: bold;">✅ Máxima concentración</td>
        </tr>
        <tr>
          <td style="padding: 1.2rem; border-bottom: 1px solid #eee; font-weight: 500;">Versatilidad</td>
          <td style="padding: 1.2rem; border-bottom: 1px solid #eee; color: #888;">❌ Muy limitada</td>
          <td style="padding: 1.2rem; border-bottom: 1px solid #eee; color: #2D8F4E; font-weight: bold;">✅ Multitarea / Comodidad</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

{% schema %}
{
  "name": "tabla-comparativa"
}
{% endschema %}
