<section class="tabla-comparativa-section">
  <div class="container-narrow">
    
    <header class="comparativa-header">
      <h2 class="comparativa-title">Why choose ZenDesk Pro?</h2>
      <p class="comparativa-subtitle">
        The difference between continuing to suffer and working with absolute comfort
      </p>
    </header>

    <div class="table-wrapper">
      <table class="comparison-table">
        
        <thead>
          <tr>
            <th class="table-header-label">Feature</th>
            <th class="table-header-without">
              <div class="header-content">
                <span class="header-icon">❌</span>
                <span>Without ZenDesk Pro</span>
              </div>
            </th>
            <th class="table-header-with">
              <div class="header-content">
                <span class="header-icon">✅</span>
                <span>With ZenDesk Pro</span>
              </div>
            </th>
          </tr>
        </thead>

        <tbody>
          
          <!-- Row 1: Comfort -->
          <tr>
            <td class="table-label">
              <strong>Comfort</strong>
            </td>
            <td class="table-cell-without">
              <span class="cell-content">
                <span class="cell-icon">❌</span>
                <span>Bad / Unstable</span>
              </span>
            </td>
            <td class="table-cell-with">
              <span class="cell-content">
                <span class="cell-icon">✅</span>
                <span>Total / Ergonomic</span>
              </span>
            </td>
          </tr>

          <!-- Row 2: Health -->
          <tr>
            <td class="table-label">
              <strong>Health (Back/Neck)</strong>
            </td>
            <td class="table-cell-without">
              <span class="cell-content">
                <span class="cell-icon">❌</span>
                <span>Constant tension</span>
              </span>
            </td>
            <td class="table-cell-with">
              <span class="cell-content">
                <span class="cell-icon">✅</span>
                <span>Correct posture</span>
              </span>
            </td>
          </tr>

          <!-- Row 3: Productivity -->
          <tr>
            <td class="table-label">
              <strong>Productivity</strong>
            </td>
            <td class="table-cell-without">
              <span class="cell-content">
                <span class="cell-icon">❌</span>
                <span>Low / Distraction</span>
              </span>
            </td>
            <td class="table-cell-with">
              <span class="cell-content">
                <span class="cell-icon">✅</span>
                <span>Maximum focus</span>
              </span>
            </td>
          </tr>

          <!-- Row 4: Versatility -->
          <tr>
            <td class="table-label">
              <strong>Versatility</strong>
            </td>
            <td class="table-cell-without">
              <span class="cell-content">
                <span class="cell-icon">❌</span>
                <span>Very limited</span>
              </span>
            </td>
            <td class="table-cell-with">
              <span class="cell-content">
                <span class="cell-icon">✅</span>
                <span>Multifunctional</span>
              </span>
            </td>
          </tr>

          <!-- Row 5: Durability -->
          <tr>
            <td class="table-label">
              <strong>Durability</strong>
            </td>
            <td class="table-cell-without">
              <span class="cell-content">
                <span class="cell-icon">❌</span>
                <span>Breaks easily</span>
              </span>
            </td>
            <td class="table-cell-with">
              <span class="cell-content">
                <span class="cell-icon">✅</span>
                <span>Premium material</span>
              </span>
            </td>
          </tr>

          <!-- Row 6: Design -->
          <tr>
            <td class="table-label">
              <strong>Design</strong>
            </td>
            <td class="table-cell-without">
              <span class="cell-content">
                <span class="cell-icon">❌</span>
                <span>Ugly / Generic</span>
              </span>
            </td>
            <td class="table-cell-with">
              <span class="cell-content">
                <span class="cell-icon">✅</span>
                <span>Minimalist / Elegant</span>
              </span>
            </td>
          </tr>

        </tbody>

      </table>
    </div>

  </div>
</section>

<style>
  /* ============================================
     TABLA COMPARATIVA - PREMIUM STYLING
     ============================================ */
  
  .tabla-comparativa-section {
    background: #FFFFFF;
    padding: var(--space-3xl) 0;
  }

  .comparativa-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .comparativa-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin-bottom: var(--space-md);
    color: var(--color-text-primary);
  }

  .comparativa-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* ============================================
     TABLE WRAPPER - RESPONSIVE CONTAINER
     ============================================ */
  
  .table-wrapper {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-strong);
    background: #FFFFFF;
  }

  /* ============================================
     COMPARISON TABLE - NATIVE STYLING
     ============================================ */
  
  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: clamp(0.9rem, 2vw, 1.1rem);
  }

  /* ============================================
     TABLE HEADER
     ============================================ */
  
  .comparison-table thead tr {
    background: linear-gradient(135deg, #F3F4F6 0%, #E5E7EB 100%);
  }

  .table-header-label {
    padding: var(--space-lg);
    text-align: left;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    border-bottom: 2px solid #D1D5DB;
  }

  .table-header-without {
    padding: var(--space-lg);
    text-align: center;
    background: linear-gradient(135deg, #FEE2E2 0%, #FECACA 100%);
    border-bottom: 2px solid #FCA5A5;
  }

  .table-header-with {
    padding: var(--space-lg);
    text-align: center;
    background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
    border-bottom: 2px solid #6EE7B7;
  }

  .header-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
  }

  .header-icon {
    font-size: 1.5rem;
  }

  /* ============================================
     TABLE BODY ROWS
     ============================================ */
  
  .comparison-table tbody tr {
    transition: background var(--transition-fast);
  }

  .comparison-table tbody tr:hover {
    background: #F9FAFB;
  }

  .comparison-table tbody tr:nth-child(even) {
    background: #FAFAFA;
  }

  .comparison-table tbody tr:nth-child(even):hover {
    background: #F3F4F6;
  }

  /* ============================================
     TABLE CELLS
     ============================================ */
  
  .table-label {
    padding: var(--space-lg);
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    border-bottom: 1px solid #E5E7EB;
  }

  .table-cell-without,
  .table-cell-with {
    padding: var(--space-lg);
    text-align: center;
    border-bottom: 1px solid #E5E7EB;
  }

  .table-cell-without {
    background: rgba(254, 226, 226, 0.2);
  }

  .table-cell-with {
    background: rgba(209, 250, 229, 0.2);
  }

  .cell-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
  }

  .table-cell-without .cell-content {
    color: #991B1B;
    font-weight: var(--font-weight-medium);
  }

  .table-cell-with .cell-content {
    color: var(--color-cta-green);
    font-weight: var(--font-weight-bold);
  }

  .cell-icon {
    font-size: 1.25rem;
  }

  /* ============================================
     MOBILE RESPONSIVE
     ============================================ */
  
  @media (max-width: 768px) {
    .tabla-comparativa-section {
      padding: var(--space-2xl) 0;
    }

    .table-wrapper {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .comparison-table {
      min-width: 600px;
      font-size: 0.875rem;
    }

    .table-header-label,
    .table-header-without,
    .table-header-with,
    .table-label,
    .table-cell-without,
    .table-cell-with {
      padding: var(--space-sm) var(--space-xs);
    }

    .header-content {
      font-size: 0.875rem;
    }

    .header-icon {
      font-size: 1.25rem;
    }

    .cell-icon {
      font-size: 1rem;
    }

    .cell-content {
      flex-direction: column;
      gap: 4px;
    }
  }

  @media (max-width: 480px) {
    .comparison-table {
      font-size: 0.8rem;
    }

    .table-label strong {
      font-size: 0.875rem;
    }
  }
</style>

{% schema %}
{
  "name": "tabla-comparativa"
}
{% endschema %}
