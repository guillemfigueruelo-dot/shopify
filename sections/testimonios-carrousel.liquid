<style>
  /* ============================================
     TESTIMONIOS SECTION - SOCIAL PROOF
     ============================================ */
  
  .testimonios-section {
    background: var(--color-bg-secondary);
    padding: var(--space-3xl) 0;
    overflow: hidden;
  }

  .testimonios-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--space-2xl);
  }

  .testimonios-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    margin-bottom: var(--space-md);
    color: var(--color-text-primary);
  }

  .testimonios-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* ============================================
     CAROUSEL - HORIZONTAL SCROLL
     ============================================ */
  
  .testimonials-carousel-wrapper {
    position: relative;
    margin-bottom: var(--space-xl);
  }

  .testimonials-track {
    display: flex;
    gap: var(--space-lg);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: var(--space-md) var(--space-sm) var(--space-lg);
    margin: 0 calc(var(--space-md) * -1);
  }

  /* Custom Scrollbar */
  .testimonials-track::-webkit-scrollbar {
    height: 8px;
  }

  .testimonials-track::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.05);
    border-radius: var(--radius-full);
  }

  .testimonials-track::-webkit-scrollbar-thumb {
    background: var(--color-accent-warm);
    border-radius: var(--radius-full);
    transition: background var(--transition-fast);
  }

  .testimonials-track::-webkit-scrollbar-thumb:hover {
    background: #C4984D;
  }

  /* ============================================
     TESTIMONIAL CARD - PREMIUM DESIGN
     ============================================ */
  
  .testimonial-card {
    flex: 0 0 340px;
    background: #FFFFFF;
    padding: var(--space-xl);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    transition: all var(--transition-base);
    position: relative;
  }

  .testimonial-card::before {
    content: '"';
    position: absolute;
    top: -10px;
    left: var(--space-lg);
    font-size: 6rem;
    color: var(--color-accent-warm);
    opacity: 0.1;
    font-family: Georgia, serif;
    line-height: 1;
  }

  .testimonial-card:hover {
    box-shadow: var(--shadow-medium);
    transform: translateY(-4px);
  }

  /* Stars */
  .stars {
    color: #FBBF24;
    font-size: 1.25rem;
    letter-spacing: 2px;
  }

  /* Quote */
  .testimonial-quote {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-primary);
    font-style: italic;
    margin: 0;
    flex-grow: 1;
  }

  /* Author */
  .testimonial-author {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: auto;
  }

  .author-avatar {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 3px solid var(--color-bg-secondary);
    box-shadow: var(--shadow-soft);
  }

  .author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .author-name {
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .author-role {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  /* ============================================
     SOCIAL PROOF BADGE
     ============================================ */
  
  .social-proof-badge {
    text-align: center;
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-top: var(--space-lg);
  }

  .social-proof-badge strong {
    color: var(--color-accent-warm);
    font-weight: var(--font-weight-bold);
    font-size: 1.5rem;
  }

  /* ============================================
     MOBILE RESPONSIVE
     ============================================ */
  
  @media (max-width: 768px) {
    .testimonios-section {
      padding: var(--space-2xl) 0;
    }

    .testimonial-card {
      flex: 0 0 300px;
      padding: var(--space-lg);
    }

    .testimonials-track {
      gap: var(--space-md);
      padding: var(--space-sm) var(--space-sm) var(--space-md);
    }

    .social-proof-badge {
      font-size: 1rem;
    }

    .social-proof-badge strong {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .testimonial-card {
      flex: 0 0 280px;
    }
  }
</style>

{% schema %}
{
  "name": "testimonios-carrousel"
}
{% endschema %}
