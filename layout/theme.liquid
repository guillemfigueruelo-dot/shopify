<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
 {%- capture ecom_header_content -%}{%- render 'ecom_header' -%}{%- endcapture -%}{%- unless ecom_header_content contains 'Liquid error' -%}{{ ecom_header_content }}{%- endunless -%}
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.colors_accent }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ page_title }}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
      /* ============================================
         ZENDESK PRO LANDING - PREMIUM CSS SYSTEM
         Design Philosophy: IKEA meets Apple
         Mobile-First (375px-412px core viewport)
         ============================================ */
      
      :root {
        /* Brand Colors - Ultra Clean Palette */
        --color-bg-primary: #FAFAFA;
        --color-bg-secondary: #F5F3EF;
        --color-text-primary: #1A1A1A;
        --color-text-secondary: #666666;
        --color-accent-warm: #D4A853;
        --color-cta-green: #2D8F4E;
        --color-cta-green-hover: #256b3d;
        
        /* Section-Specific Backgrounds */
        --color-pain-bg: #E5E7EB;
        --color-solution-bg: #FFFBEB;
        --color-error-soft: #FEE2E2;
        --color-success-soft: #D1FAE5;
        
        /* Typography */
        --font-primary: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-weight-normal: 400;
        --font-weight-medium: 500;
        --font-weight-semibold: 600;
        --font-weight-bold: 700;
        
        /* Spacing System (8px base) */
        --space-xs: 0.5rem;    /* 8px */
        --space-sm: 1rem;      /* 16px */
        --space-md: 1.5rem;    /* 24px */
        --space-lg: 2rem;      /* 32px */
        --space-xl: 3rem;      /* 48px */
        --space-2xl: 4rem;     /* 64px */
        --space-3xl: 6rem;     /* 96px */
        
        /* Borders & Shadows */
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-full: 9999px;
        --shadow-soft: 0 2px 8px rgba(0, 0, 0, 0.04), 0 4px 16px rgba(0, 0, 0, 0.06);
        --shadow-medium: 0 4px 12px rgba(0, 0, 0, 0.08), 0 8px 24px rgba(0, 0, 0, 0.10);
        --shadow-strong: 0 8px 20px rgba(0, 0, 0, 0.12), 0 16px 40px rgba(0, 0, 0, 0.14);
        
        /* Transitions */
        --transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-base: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-smooth: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      }

      /* ============================================
         GLOBAL RESET & BASE STYLES
         ============================================ */
      
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-size: 16px;
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }

      body {
        background-color: var(--color-bg-primary);
        color: var(--color-text-primary);
        font-family: var(--font-primary);
        font-weight: var(--font-weight-normal);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }

      /* ============================================
         TYPOGRAPHY SCALE
         ============================================ */
      
      h1, h2, h3, h4, h5, h6 {
        margin: 0;
        font-weight: var(--font-weight-bold);
        line-height: 1.2;
        letter-spacing: -0.02em;
      }

      h1 {
        font-size: clamp(2rem, 6vw, 3.5rem);
      }

      h2 {
        font-size: clamp(1.75rem, 5vw, 2.5rem);
      }

      h3 {
        font-size: clamp(1.25rem, 3vw, 1.75rem);
      }

      p {
        margin: 0;
        line-height: 1.7;
      }

      a {
        color: inherit;
        text-decoration: none;
        transition: color var(--transition-fast);
      }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      /* ============================================
         BUTTONS & CTAs (Premium Design)
         ============================================ */
      
      .button, 
      .btn, 
      .cta,
      button[type="submit"] {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(180deg, var(--color-cta-green) 0%, var(--color-cta-green-hover) 100%);
        color: #FFFFFF;
        font-family: var(--font-primary);
        font-size: 1.125rem;
        font-weight: var(--font-weight-bold);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 1.125rem 2.5rem;
        border: none;
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-soft);
        cursor: pointer;
        transition: all var(--transition-base);
        text-align: center;
        min-height: 56px; /* Thumb-friendly mobile target */
        -webkit-tap-highlight-color: transparent;
      }

      .button:hover, 
      .btn:hover, 
      .cta:hover,
      button[type="submit"]:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-medium);
        background: var(--color-cta-green-hover);
      }

      .button:active,
      .btn:active,
      .cta:active,
      button[type="submit"]:active {
        transform: translateY(0);
        box-shadow: var(--shadow-soft);
      }

      /* ============================================
         LAYOUT CONTAINERS
         ============================================ */
      
      main {
        width: 100%;
        margin: 0;
        padding: 0;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 var(--space-md);
      }

      .container-narrow {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 var(--space-md);
      }

      /* ============================================
         UTILITY CLASSES
         ============================================ */
      
      .text-center {
        text-align: center;
      }

      .text-accent {
        color: var(--color-accent-warm);
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }

      /* ============================================
         MOBILE-FIRST RESPONSIVE BREAKPOINTS
         ============================================ */
      
      @media (max-width: 768px) {
        :root {
          --space-xl: 2rem;
          --space-2xl: 3rem;
          --space-3xl: 4rem;
        }
        
        h1 {
          font-size: clamp(1.75rem, 5vw, 2.25rem);
        }
        
        h2 {
          font-size: clamp(1.5rem, 4vw, 2rem);
        }

        .container,
        .container-narrow {
          padding: 0 var(--space-sm);
        }

        .button,
        .btn,
        .cta,
        button[type="submit"] {
          width: 100%;
          font-size: 1rem;
          padding: 1rem 1.5rem;
        }
      }

      @media (min-width: 769px) and (max-width: 1024px) {
        .container {
          padding: 0 var(--space-lg);
        }
      }

      /* ============================================
         SMOOTH ANIMATIONS & TRANSITIONS
         ============================================ */
      
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>

  <body>
    <main role="main">
      {{ content_for_layout }}
    </main>
  {%- capture ecom_footer_content -%}{%- render 'ecom_footer' -%}{%- endcapture -%}{%- unless ecom_footer_content contains 'Liquid error' -%}{{ ecom_footer_content }}{%- endunless -%}</body>
</html>
